# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 대화 모델 — 업스테이지 솔라 (기본). Document Parse 와 같은 열쇠
UPSTAGE_API_KEY=your_upstage_api_key
# 되돌리기 스위치: solar | gemini (비우면 솔라 열쇠 있을 때 솔라)
LLM_DRIVER=
LLM_MODEL_CHAT=solar-pro4
LLM_MODEL_MINI=solar-mini4

# Gemini AI (사진 붙은 대화·사진 도구·되돌아가기용)
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs TTS (Phase 2)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key
CRON_SECRET=your_cron_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=큐리 AI

# 메시징 — 웹푸시(무료). 열쇠 만들기: node scripts/webpush-keys.mjs
WEBPUSH_VAPID_PUBLIC=your_vapid_public_key
WEBPUSH_VAPID_PRIVATE=your_vapid_private_key
WEBPUSH_SUBJECT=mailto:your_contact_email
# 메시징 — 문자(솔라피). 돈 드는 채널이라 SMS_ENABLED=true 를 넣어야만 나간다(대표 사전승인 뒤)
SMS_ENABLED=
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
SOLAPI_SENDER_NUMBER=your_sender_number
# 메시징 — 이메일(AWS SES). 넷 중 하나라도 없으면 blocked 로 기록만
SES_REGION=ap-northeast-2
SES_FROM=your_verified_sender_email
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# 외부 연결(커넥터) — 사용자가 붙여 넣는 노션 토큰·슬랙 웹훅 주소를 잠그는 자물쇠(32바이트)
# 없으면 연결 기능이 「준비 중」으로 꺼진다. 만들기:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_SECRET_KEY=your_connector_secret_key
